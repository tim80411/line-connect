# ===== Required =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
DIFY_API_KEY=

# ===== Dify =====
#DIFY_API_BASE_URL=https://api.dify.ai/v1
#DIFY_CONNECT_TIMEOUT=10
#DIFY_STREAM_READ_TIMEOUT=180
#DIFY_BLOCKING_TIMEOUT=180
#DIFY_IMAGE_VARIABLE=img
#DIFY_FILE_VARIABLE=files
# Comma-separated substrings that mark a 4xx body as "conversation not found".
#DIFY_CONVERSATION_ERROR_MARKERS=Conversation Not Exists,conversation not found

# ===== Behavior =====
#PASS_DISPLAY_NAME=true
#DISPLAY_NAME_VARIABLE=displayName
#MEDIA_SUPPORT_ENABLED=false
#IMAGE_PROMPT=Describe this image
#MULTI_IMAGE_PROMPT_TEMPLATE=User sent {count} images
#FILE_PROMPT_TEMPLATE=User sent a {kind} file
#MEDIA_DEBOUNCE_SECONDS=0
#MEDIA_DEBOUNCE_MAX_SECONDS=30
#MEDIA_MAX_DOWNLOAD_MB=20
#FLEX_MESSAGE_ENABLED=false
#STRIP_MARKDOWN=true
#WELCOME_MESSAGE=Welcome! Send me a message to get started.
#CLEAR_COMMANDS=/clear,/reset,/new
#CLEAR_CONFIRM_MESSAGE=Conversation cleared!
#GENERIC_ERROR_MESSAGE=Sorry, something went wrong. Please try again.
# WARNING: sends truncated tracebacks to the LINE chat. Never enable in production.
#DEBUG_MODE=false

# ===== Infrastructure =====
#DATABASE_PATH=/data/line-connect.db
#WORKER_COUNT=4
#QUEUE_MAX_SIZE=500
#JOB_TIMEOUT_SECONDS=240
#REPLY_TOKEN_TTL_SECONDS=50
#MAX_RECOVERY_AGE_SECONDS=120
#SHUTDOWN_GRACE_SECONDS=25
#DRAIN_DELAY_SECONDS=5
#DEDUP_RETENTION_DAYS=3
#MESSAGE_LOG_ENABLED=true
#MESSAGE_LOG_RETENTION_DAYS=30
#LINE_API_TIMEOUT=10
#LOG_LEVEL=INFO
#LOG_FORMAT=json
#WEBHOOK_PATH=/line/webhook
